# eslint is pinned at ^5.16.0 while eslint-config-standard@^13.0.1 declares a peer of
# eslint >= 6.0.1. npm 6, which this repo was written against, ignored peer conflicts;
# npm 7 and later refuse to install at all:
#
#   npm error Conflicting peer dependency: eslint
#   peer eslint@">=6.0.1" from eslint-config-standard@13.0.1
#
# The two do work together in practice (verified: npm ci succeeds and `npm run lint`
# runs clean with eslint 5.16.0 and eslint-config-standard 13.0.1 installed), so this
# restores the npm 6 behaviour rather than moving either pin. Bumping eslint would be a
# dependency upgrade, which this repo deliberately avoids.
legacy-peer-deps=true
