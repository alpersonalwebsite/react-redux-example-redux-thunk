# Copy to .env and edit. .env is gitignored.
#
# Create React App exposes REACT_APP_-prefixed variables to the bundle, plus the two
# built-ins NODE_ENV and PUBLIC_URL. Nothing else in your environment reaches client
# code. What does reach it is INLINED at build time, so it ships inside
# build/static/js/*.js in plain sight: fine for an endpoint, never for a secret.
#
# Defaults to the local API from alpersonalwebsite/node-express-postgresql.
REACT_APP_API_URL=http://localhost:3333/api/users
